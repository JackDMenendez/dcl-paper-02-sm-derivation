# Byte-compiled / optimized / DLL files
__pycache__/
*.py[codz]

# external workspace folders (Windows symlinks to sibling repos)
.external/
external/
.scratchpad/
# Durable versioned PDF snapshots (kept across `make clean`)
.stage/

# Editor / IDE
.vscode/
.vs/
.idea/

# Build outputs
# .build/ is the make working area; .stage/ (ignored above) is the durable
# per-version archive.  The undotted names are kept so that trees predating
# the dot-prefixed layout stay ignored too.
.build/
build/
stage/

# Experiment side-effects (logs are tracked via the !data/*.log allow rule
# below; .err captures and one-off scratch files are not).
data/*.err

# Per-machine Claude Code state
.claude/settings.json
.claude/settings.local.json

# LaTeX intermediates (the main PDF lives in .build/, promoted to .stage/)
# Stray PDFs built inside paper/ (e.g. pdflatex without -output-directory)
paper/*.pdf
*.aux
*.bbl
*.blg
*.log
!data/*.log
*.out
*.toc
*.fls
*.fdb_latexmk
*.fdb_latexmk_*
*.synctex.gz

# Python virtual environments (used by the full-stack template; harmless here)
.venv
.venv*
env/
venv/
ENV/

# Test / coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# OS junk
.DS_Store
Thumbs.db
.vsisolation/
